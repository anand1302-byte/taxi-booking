<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #f8f8f8;
            padding: 20px;
        }
        .form {
            background: white;
            padding: 20px;
            max-width: 400px;
            margin: auto;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
        input, button {
            width: 100%;
            margin: 10px 0;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        button {
            background: #27ae60;
            color: white;
            border: none;
            cursor: pointer;
        }
        button:hover {
            background: #219150;
        }
        table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background: #27ae60;
            color: white;
        }
        img {
            border-radius: 5px;
        }
        td:last-child, td:nth-last-child(2) {
            text-align: center;
        }
        td button {
            padding: 5px 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .edit-btn {
            background: #f39c12;
            color: white;
        }
        .delete-btn {
            background: #e74c3c;
            color: white;
        }
    </style>
</head>
<body>
    <form action="/add" method="post" enctype="multipart/form-data" class="form">
        <input type="text" placeholder="Enter title" name="title" required>
        <input type="file" name="image" required>
        <input type="text" placeholder="Enter description" name="description" required>
        <input type="text" placeholder="Enter price" name="price" required>
        <button type="submit">Add</button>
    </form>

    <table>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Description</th>
            <th>Price</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
        <% user.forEach(product => { %>
        <tr>
            <td><img src="data:<%= product.image.contentType %>;base64,<%= product.image.data.toString('base64') %>" width="50"></td>
            <td><%= product.title %></td>
            <td><%= product.description %></td>
            <td>₹ <%= product.price %></td>
            <td><button class="edit-btn" onclick="openEditPopup('<%= product._id %>', '<%= product.title %>', '<%= product.description %>', '<%= product.price %>')">Edit</button></td>
            <td>
                <form action="/delete/<%= product._id %>" method="POST">
                    <button type="submit" class="delete-btn">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </table>
    <div id="editPopup" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); background:white; padding:20px; box-shadow:0px 0px 10px gray;">
        <h3>Edit Product</h3>
        <form id="editForm" action="" method="POST" enctype="multipart/form-data">
            <input type="text" id="editTitle" name="title" required>
            <input id="editDescription" name="description" required>
            <input type="number" id="editPrice" name="price" required>
            <input type="file" name="image">
            <button type="submit">Update</button>
            <button type="button" onclick="closeEditPopup()">Cancel</button>
        </form>
    </div>
    <script>
        function openEditPopup(id, title, description, price) {
            document.getElementById("editForm").action = "/edit/" + id;
            document.getElementById("editTitle").value = title;
            document.getElementById("editDescription").value = description;
            document.getElementById("editPrice").value = price;
            document.getElementById("editPopup").style.display = "block";
        }
        function closeEditPopup() {
            document.getElementById("editPopup").style.display = "none";
        }
    </script>
</body>
</html>
